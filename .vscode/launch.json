{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: app.py",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "${workspaceFolder}/app.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      // Don't attach the debugger to child processes: it kills the Jupyter
      // kernel that runs notebooks clicked in the tree.
      "subProcess": false
    }
  ]
}
